# seam-scanner env. Copy to .env (never commit .env). Secrets live only here (CLAUDE.md rule 7).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true: print messages instead of sending them
SEAM_DRY_RUN=false
# events to send (default lock,break_up,break_down,fail — the indicator's alert defaults)
# SEAM_EVENTS=lock,break_up,break_down,fail
# state file (default: seam/scanner/scanner-state.json)
# SEAM_STATE_FILE=
