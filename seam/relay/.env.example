# seam-relay 환경 변수 예시. 복사해서 .env 로 쓰고, .env 는 절대 커밋하지 않습니다.
# 시크릿은 여기(서버 env)에만 둡니다. Pine 스크립트나 TradingView 알림 메시지에 넣지 않습니다.

# ── 웹훅 인증 (둘 중 하나 이상 필수) ─────────────────────────────
# TradingView 는 커스텀 헤더를 못 보내므로 URL 경로에 비밀 토큰을 둡니다.
#   TradingView 알림 Webhook URL = https://<도메인>/hook/<SEAM_WEBHOOK_TOKEN>
# 생성 예: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SEAM_WEBHOOK_TOKEN=
# (선택) TradingView 외 발신자용 HMAC. 헤더 X-Seam-Signature: sha256=<hex(HMAC-SHA256(body))>
SEAM_HMAC_SECRET=

# ── 텔레그램 ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# 개인 DM: 내 user id (숫자) · 슈퍼그룹: -100 으로 시작하는 id · 공개 채널: @채널명
TELEGRAM_CHAT_ID=
# (선택) 슈퍼그룹 토픽 message_thread_id. 비우면 채팅 본문으로 보냅니다.
TELEGRAM_TOPIC_KR=
TELEGRAM_TOPIC_US=
TELEGRAM_TOPIC_CRYPTO=
TELEGRAM_TOPIC_OTHER=
# (선택) 종가 확정 돌파(break_up / break_down)를 한 번 더 받을 토픽 (#confirmed-only)
TELEGRAM_TOPIC_CONFIRMED=

# ── 필터 ─────────────────────────────────────────────────────────
# 보낼 이벤트. 기본: lock,break_up,break_down,fail  (가능: lock,break_up,break_down,retest,fail,expire)
SEAM_EVENTS=lock,break_up,break_down,fail
# reference(미달) 구조와 봉마감 전 미리보기는 기본으로 버립니다.
SEAM_ALLOW_REFERENCE=false
SEAM_ALLOW_PREVIEW=false
# (선택) 이 종목만 받기. 쉼표 구분, EXCHANGE:SYMBOL
SEAM_TICKER_ALLOWLIST=
# 종목당 분당 최대 메시지 수 (스펙: 3)
SEAM_RATE_PER_MIN=3
# 같은 구조 · 같은 이벤트 중복 차단 유지 시간 (시간)
SEAM_DEDUPE_TTL_HOURS=72

# ── 라우팅 ───────────────────────────────────────────────────────
# (선택) 거래소 접두어 추가. 예: KR=NXT;US=ARCA2;CRYPTO=LBANK  (기본 목록에 더해짐)
SEAM_MARKET_PREFIXES=

# ── 서버 ─────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
SEAM_MAX_BODY_BYTES=4096
# TradingView 웹훅 IP 에서 온 요청만 허용 (보조 수단). 리버스 프록시 뒤라면 SEAM_TRUST_PROXY=true 도 함께.
SEAM_TV_IP_ONLY=false
SEAM_TRUST_PROXY=false
# true 면 텔레그램으로 보내지 않고 로그에만 찍습니다 (설치 점검용)
SEAM_DRY_RUN=false
