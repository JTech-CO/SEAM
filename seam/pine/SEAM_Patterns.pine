//@version=5
indicator("SEAM Patterns", shorttitle="SEAM", overlay=true, max_lines_count=40, max_labels_count=40, max_boxes_count=20)

// SEAM P0 — BOX + TRI_SYM
// PRINCIPLE: confirm-on-close
// PRINCIPLE: lock-on-recognize (upper/lower/slope never refit after lock)
// PRINCIPLE: touch or it is not a line
// PRINCIPLE: show != signal (formal / reference)
// PRINCIPLE: no raw numeric playground — presets only

// ─────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────
string iSens     = input.string("normal", "민감도", options=["loose", "normal", "strict"], group="SEAM")
int    iDrawN    = input.int(1, "표시 개수", minval=1, maxval=3, group="SEAM")
bool   iShowRef  = input.bool(true, "reference 표시", group="SEAM")
bool   iShowForm = input.bool(true, "forming 미리보기", group="SEAM")
bool   iPanel    = input.bool(true, "상태 패널", group="SEAM")
bool   iAlerts   = input.bool(true, "확정 알림", group="알림")
bool   iPreviewA = input.bool(false, "미리보기 알림 (비권장)", group="알림")

color  cFormal   = input.color(color.new(#4C8BF5, 0), "formal", group="색")
color  cRef      = input.color(color.new(#8B93A7, 70), "reference", group="색")
color  cForming  = input.color(color.new(#8B93A7, 80), "forming", group="색")
color  cUp       = input.color(color.new(#2E7D32, 0), "상단 돌파", group="색")
color  cDn       = input.color(color.new(#C62828, 0), "하단 이탈", group="색")

// ─────────────────────────────────────────
// Presets — PRINCIPLE: no raw numeric playground
// ─────────────────────────────────────────
int    pivLen    = iSens == "loose" ? 3 : iSens == "strict" ? 8 : 5
int    minWidth  = iSens == "loose" ? 8 : iSens == "strict" ? 18 : 12
int    maxWidth  = iSens == "loose" ? 80 : iSens == "strict" ? 60 : 70
int    minTouches = iSens == "loose" ? 2 : 3
float  maxGapAtr = iSens == "loose" ? 0.35 : iSens == "strict" ? 0.15 : 0.25
float  minAdh    = iSens == "loose" ? 0.40 : iSens == "strict" ? 0.65 : 0.55
int    maxKeep   = iSens == "loose" ? 90 : iSens == "strict" ? 50 : 70
float  brkBufAtr = iSens == "loose" ? 0.08 : iSens == "strict" ? 0.03 : 0.05
int    lookback  = 80

float atr = ta.atr(14)

// ─────────────────────────────────────────
// Types
// ─────────────────────────────────────────
type Seam
    string key
    string grade          // formal | reference | reject
    string phase          // forming | locked | break_up | break_down | failed | expired
    int    lockBar
    float  upper
    float  lower
    float  upperSlope     // price per bar, frozen at lock
    float  lowerSlope
    int    touchesU
    int    touchesL
    float  adhesion
    int    widthBars
    float  heightAtr
    string rejectReason
    line   lnU
    line   lnL
    bool   alertedLock
    bool   alertedBreak
    bool   dead

// ─────────────────────────────────────────
// Confirmed pivots (right side must close)
// ─────────────────────────────────────────
float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low, pivLen, pivLen)

var float[] pHigh = array.new_float()
var float[] pLow  = array.new_float()
var int[]   pHighBar = array.new_int()
var int[]   pLowBar  = array.new_int()

MAX_PV = 24

f_push_cap(float[] a, int[] b, float v, int bar) =>
    array.push(a, v)
    array.push(b, bar)
    if array.size(a) > MAX_PV
        array.shift(a)
        array.shift(b)

if not na(ph)
    f_push_cap(pHigh, pHighBar, ph, bar_index - pivLen)
if not na(pl)
    f_push_cap(pLow, pLowBar, pl, bar_index - pivLen)

f_count_touches_h(float level, int fromBar, int toBar, bool useHigh) =>
    int n = 0
    int span = math.max(1, toBar - fromBar)
    int step = math.max(1, int(span / 40))
    for i = fromBar to toBar by step
        float px = useHigh ? high[bar_index - i] : low[bar_index - i]
        if not na(px) and math.abs(px - level) <= maxGapAtr * atr
            n += 1
    n

f_adhesion_h(float level, int fromBar, int toBar, bool useHigh) =>
    float acc = 0.0
    int n = 0
    int span = math.max(1, toBar - fromBar)
    int step = math.max(1, int(span / 24))
    for i = fromBar to toBar by step
        float px = useHigh ? high[bar_index - i] : low[bar_index - i]
        if not na(px) and atr > 0
            acc += math.abs(px - level) / atr
            n += 1
    float gap = n > 0 ? acc / n : 9.0
    math.max(0.0, math.min(1.0, 1.0 - gap / math.max(maxGapAtr * 2.0, 0.01)))

// Sample price along a sloped line (frozen formula after lock)
f_line_y(float y0, float slope, int lockBar, int atBar) =>
    y0 + slope * (atBar - lockBar)

f_count_touches_s(float y0, float slope, int lockBar, int fromBar, int toBar, bool useHigh) =>
    int n = 0
    int span = math.max(1, toBar - fromBar)
    int step = math.max(1, int(span / 40))
    for i = fromBar to toBar by step
        float lv = f_line_y(y0, slope, lockBar, i)
        float px = useHigh ? high[bar_index - i] : low[bar_index - i]
        if not na(px) and math.abs(px - lv) <= maxGapAtr * atr
            n += 1
    n

f_adhesion_s(float y0, float slope, int lockBar, int fromBar, int toBar, bool useHigh) =>
    float acc = 0.0
    int n = 0
    int span = math.max(1, toBar - fromBar)
    int step = math.max(1, int(span / 24))
    for i = fromBar to toBar by step
        float lv = f_line_y(y0, slope, lockBar, i)
        float px = useHigh ? high[bar_index - i] : low[bar_index - i]
        if not na(px) and atr > 0
            acc += math.abs(px - lv) / atr
            n += 1
    float gap = n > 0 ? acc / n : 9.0
    math.max(0.0, math.min(1.0, 1.0 - gap / math.max(maxGapAtr * 2.0, 0.01)))

f_grade(int tu, int tl, float adh, int width, float heightAtr, string extraFail) =>
    string reason = extraFail
    string g = "formal"
    if extraFail != ""
        g := "reference"
    else if tu < minTouches or tl < minTouches
        g := "reference"
        reason := "접점 부족"
    else if adh < minAdh
        g := "reference"
        reason := "선이 뜸"
    else if width < minWidth
        g := "reference"
        reason := "폭 부족"
    else if heightAtr < 0.6
        g := "reference"
        reason := "높이 부족"
    [g, reason]

f_delete_lines(Seam s) =>
    if not na(s.lnU)
        line.delete(s.lnU)
    if not na(s.lnL)
        line.delete(s.lnL)

f_style_of(string grade, string phase) =>
    grade == "forming" or phase == "forming" ? line.style_dotted : line.style_solid

f_col_of(Seam s) =>
    s.phase == "break_up" ? cUp : s.phase == "break_down" ? cDn : s.grade == "formal" ? cFormal : cRef

f_draw(Seam s, int x2) =>
    f_delete_lines(s)
    int x1 = s.lockBar
    float yU1 = s.upper
    float yL1 = s.lower
    float yU2 = f_line_y(s.upper, s.upperSlope, s.lockBar, x2)
    float yL2 = f_line_y(s.lower, s.lowerSlope, s.lockBar, x2)
    color col = f_col_of(s)
    string st = s.phase == "forming" ? line.style_dotted : line.style_solid
    int w = s.grade == "formal" ? 2 : 1
    s.lnU := line.new(x1, yU1, x2, yU2, xloc=xloc.bar_index, color=col, width=w, style=st)
    s.lnL := line.new(x1, yL1, x2, yL2, xloc=xloc.bar_index, color=col, width=w, style=st)

// ─────────────────────────────────────────
// Active structures (cap small — P0)
// ─────────────────────────────────────────
var Seam[] bag = array.new<Seam>()
MAX_BAG = 6

f_overlap(Seam a, int fromB, int toB) =>
    int a1 = a.lockBar
    int a2 = a.lockBar + a.widthBars
    int lo = math.max(a1, fromB)
    int hi = math.min(a2, toB)
    hi > lo and (hi - lo) > int(0.5 * math.max(1, math.min(a.widthBars, toB - fromB)))

f_push_seam(Seam s) =>
    // drop overlapping same-key weaker ones
    int i = array.size(bag) - 1
    while i >= 0
        Seam o = array.get(bag, i)
        if o.key == s.key and not o.dead and f_overlap(o, s.lockBar, s.lockBar + s.widthBars)
            if s.adhesion >= o.adhesion
                f_delete_lines(o)
                o.dead := true
            else
                s.dead := true
        i -= 1
    if not s.dead
        array.push(bag, s)
        if array.size(bag) > MAX_BAG
            Seam old = array.shift(bag)
            f_delete_lines(old)

// ─────────────────────────────────────────
// Detect BOX (horizontal)
// Uses last 3 confirmed highs / lows
// ─────────────────────────────────────────
f_try_box() =>
    Seam out = na
    int nh = array.size(pHigh)
    int nl = array.size(pLow)
    if nh >= 2 and nl >= 2
        float h1 = array.get(pHigh, nh - 1)
        float h2 = array.get(pHigh, nh - 2)
        int   hb1 = array.get(pHighBar, nh - 1)
        int   hb2 = array.get(pHighBar, nh - 2)
        float l1 = array.get(pLow, nl - 1)
        float l2 = array.get(pLow, nl - 2)
        int   lb1 = array.get(pLowBar, nl - 1)
        int   lb2 = array.get(pLowBar, nl - 2)
        float upper = (h1 + h2) / 2.0
        float lower = (l1 + l2) / 2.0
        float flatTol = maxGapAtr * atr * 1.2
        bool highsFlat = math.abs(h1 - h2) <= flatTol
        bool lowsFlat  = math.abs(l1 - l2) <= flatTol
        int left = math.min(math.min(hb1, hb2), math.min(lb1, lb2))
        int right = math.max(math.max(hb1, hb2), math.max(lb1, lb2))
        int width = right - left
        float height = upper - lower
        string extra = ""
        if not highsFlat or not lowsFlat
            extra := "수평 아님"
        else if height <= 0
            extra := "높이 없음"
        else if width > maxWidth
            extra := "폭 과다"
        if extra != "높이 없음" and height > 0
            int tu = f_count_touches_h(upper, left, bar_index, true)
            int tl = f_count_touches_h(lower, left, bar_index, false)
            float adhU = f_adhesion_h(upper, left, bar_index, true)
            float adhL = f_adhesion_h(lower, left, bar_index, false)
            float adh = (adhU + adhL) / 2.0
            float hAtr = atr > 0 ? height / atr : 0.0
            [g, reason] = f_grade(tu, tl, adh, width, hAtr, extra)
            if g != "reject" and adh > 0.15 and width >= math.max(6, int(minWidth * 0.6))
                Seam s = Seam.new()
                s.key := "BOX"
                s.grade := g
                s.phase := "locked"
                s.lockBar := bar_index          // PRINCIPLE: lock-on-recognize
                s.upper := upper                // frozen
                s.lower := lower                // frozen
                s.upperSlope := 0.0
                s.lowerSlope := 0.0
                s.touchesU := tu
                s.touchesL := tl
                s.adhesion := adh
                s.widthBars := width
                s.heightAtr := hAtr
                s.rejectReason := reason
                s.alertedLock := false
                s.alertedBreak := false
                s.dead := false
                out := s
    out

// ─────────────────────────────────────────
// Detect TRI_SYM (falling highs + rising lows)
// Last 3 highs / 3 lows → fit two slopes, lock at recognize bar
// ─────────────────────────────────────────
f_slope(int x1, float y1, int x2, float y2) =>
    x2 == x1 ? 0.0 : (y2 - y1) / (x2 - x1)

f_try_tri() =>
    Seam out = na
    int nh = array.size(pHigh)
    int nl = array.size(pLow)
    if nh >= 3 and nl >= 3
        int hx1 = array.get(pHighBar, nh - 3)
        int hx2 = array.get(pHighBar, nh - 2)
        int hx3 = array.get(pHighBar, nh - 1)
        float hy1 = array.get(pHigh, nh - 3)
        float hy2 = array.get(pHigh, nh - 2)
        float hy3 = array.get(pHigh, nh - 1)
        int lx1 = array.get(pLowBar, nl - 3)
        int lx2 = array.get(pLowBar, nl - 2)
        int lx3 = array.get(pLowBar, nl - 1)
        float ly1 = array.get(pLow, nl - 3)
        float ly2 = array.get(pLow, nl - 2)
        float ly3 = array.get(pLow, nl - 1)
        // first-to-last slope (stable, not refit later)
        float us = f_slope(hx1, hy1, hx3, hy3)
        float ls = f_slope(lx1, ly1, lx3, ly3)
        int left = math.min(hx1, lx1)
        int right = math.max(hx3, lx3)
        int width = right - left
        // evaluate line at lock bar (now)
        float upperNow = hy3 + us * (bar_index - hx3)
        float lowerNow = ly3 + ls * (bar_index - lx3)
        float height = upperNow - lowerNow
        float earlyH = (hy1 + us * (left - hx3)) - (ly1 + ls * (left - lx3))
        string extra = ""
        if us >= -0.0000001
            extra := "상단 미하락"
        else if ls <= 0.0000001
            extra := "하단 미상승"
        else if height <= 0
            extra := "교차됨"
        else if earlyH > 0 and height >= earlyH * 0.95
            extra := "미수렴"
        else if width > maxWidth
            extra := "폭 과다"
        if extra != "교차됨" and height > 0
            int tu = f_count_touches_s(upperNow, us, bar_index, left, bar_index, true)
            int tl = f_count_touches_s(lowerNow, ls, bar_index, left, bar_index, false)
            float adhU = f_adhesion_s(upperNow, us, bar_index, left, bar_index, true)
            float adhL = f_adhesion_s(lowerNow, ls, bar_index, left, bar_index, false)
            float adh = (adhU + adhL) / 2.0
            float hAtr = atr > 0 ? height / atr : 0.0
            [g, reason] = f_grade(tu, tl, adh, width, hAtr, extra)
            if g != "reject" and adh > 0.12 and width >= math.max(6, int(minWidth * 0.6))
                Seam s = Seam.new()
                s.key := "TRI_SYM"
                s.grade := g
                s.phase := "locked"
                s.lockBar := bar_index
                s.upper := upperNow             // frozen at recognize
                s.lower := lowerNow
                s.upperSlope := us              // frozen
                s.lowerSlope := ls
                s.touchesU := tu
                s.touchesL := tl
                s.adhesion := adh
                s.widthBars := width
                s.heightAtr := hAtr
                s.rejectReason := reason
                s.alertedLock := false
                s.alertedBreak := false
                s.dead := false
                out := s
    out

// ─────────────────────────────────────────
// Forming preview (unconfirmed last swings) — no lock, no alert by default
// ─────────────────────────────────────────
var line prevU = na
var line prevL = na

f_clear_preview() =>
    if not na(prevU)
        line.delete(prevU)
    if not na(prevL)
        line.delete(prevL)
    prevU := na
    prevL := na

// ─────────────────────────────────────────
// Main — only on confirmed close
// ─────────────────────────────────────────
jsonAlert = ""

f_payload(Seam s, string event, bool preview) =>
    string p = '{"v":1,"src":"seam","event":"' + event + '","ticker":"' + syminfo.tickerid + '","tf":"' + timeframe.period + '","key":"' + s.key + '","grade":"' + s.grade + '","phase":"' + s.phase + '","lock_ts":' + str.tostring(s.lockBar) + ',"upper":' + str.tostring(s.upper, "#.####") + ',"lower":' + str.tostring(s.lower, "#.####") + ',"close":' + str.tostring(close, "#.####") + ',"adhesion":' + str.tostring(s.adhesion, "#.###") + ',"preview":' + (preview ? "true" : "false") + '}'
    p

if barstate.isconfirmed
    // 1) advance locked structures — NEVER refit upper/lower/slope
    int i = 0
    while i < array.size(bag)
        Seam s = array.get(bag, i)
        if not s.dead and s.phase != "expired" and s.phase != "failed"
            float liveU = f_line_y(s.upper, s.upperSlope, s.lockBar, bar_index)
            float liveL = f_line_y(s.lower, s.lowerSlope, s.lockBar, bar_index)
            float buf = brkBufAtr * atr
            int age = bar_index - s.lockBar
            if age > maxKeep or (s.key == "TRI_SYM" and liveU - liveL <= 0.15 * atr)
                s.phase := "expired"
                s.dead := true
                f_delete_lines(s)
            else if s.phase == "locked" or s.phase == "forming"
                if close > liveU + buf
                    s.phase := "break_up"
                else if close < liveL - buf
                    s.phase := "break_down"
            else if s.phase == "break_up" and close < liveL - buf
                s.phase := "failed"
            else if s.phase == "break_down" and close > liveU + buf
                s.phase := "failed"
            if not s.dead
                f_draw(s, bar_index + 8)
        i += 1

    // 2) detect new structures (rate-limit: at most one new lock per bar)
    bool spawned = false
    Seam boxC = f_try_box()
    Seam triC = f_try_tri()
    Seam pick = na
    if not na(boxC) and not na(triC)
        pick := boxC.adhesion >= triC.adhesion ? boxC : triC
    else if not na(boxC)
        pick := boxC
    else if not na(triC)
        pick := triC

    if not na(pick)
        // skip if same key already live with similar level
        bool dup = false
        int j = 0
        while j < array.size(bag)
            Seam o = array.get(bag, j)
            if not o.dead and o.key == pick.key and math.abs(o.upper - pick.upper) / math.max(atr, 1e-6) < 0.4 and math.abs(o.lower - pick.lower) / math.max(atr, 1e-6) < 0.4
                dup := true
            j += 1
        if not dup
            f_push_seam(pick)
            if not pick.dead
                f_draw(pick, bar_index + 8)
                spawned := true
                if pick.grade == "formal" and iAlerts and not pick.alertedLock
                    jsonAlert := f_payload(pick, "lock", false)
                    pick.alertedLock := true

    // 3) break alerts
    int k = 0
    while k < array.size(bag)
        Seam s = array.get(bag, k)
        if not s.dead and s.grade == "formal" and iAlerts and not s.alertedBreak and (s.phase == "break_up" or s.phase == "break_down" or s.phase == "failed")
            string ev = s.phase == "break_up" ? "break_up" : s.phase == "break_down" ? "break_down" : "fail"
            if jsonAlert == ""
                jsonAlert := f_payload(s, ev, false)
            s.alertedBreak := true
        k += 1

    // 4) forming preview from most recent two pivots (not locked)
    f_clear_preview()
    if iShowForm and array.size(pHigh) >= 2 and array.size(pLow) >= 2
        int hx1 = array.get(pHighBar, array.size(pHigh) - 2)
        int hx2 = array.get(pHighBar, array.size(pHigh) - 1)
        float hy1 = array.get(pHigh, array.size(pHigh) - 2)
        float hy2 = array.get(pHigh, array.size(pHigh) - 1)
        int lx1 = array.get(pLowBar, array.size(pLow) - 2)
        int lx2 = array.get(pLowBar, array.size(pLow) - 1)
        float ly1 = array.get(pLow, array.size(pLow) - 2)
        float ly2 = array.get(pLow, array.size(pLow) - 1)
        float us = f_slope(hx1, hy1, hx2, hy2)
        float ls = f_slope(lx1, ly1, lx2, ly2)
        float yU2 = hy2 + us * (bar_index + 4 - hx2)
        float yL2 = ly2 + ls * (bar_index + 4 - lx2)
        prevU := line.new(hx1, hy1, bar_index + 4, yU2, xloc=xloc.bar_index, color=cForming, width=1, style=line.style_dotted)
        prevL := line.new(lx1, ly1, bar_index + 4, yL2, xloc=xloc.bar_index, color=cForming, width=1, style=line.style_dotted)
        if iPreviewA
            Seam tmp = Seam.new()
            tmp.key := "PREVIEW"
            tmp.grade := "reference"
            tmp.phase := "forming"
            tmp.lockBar := bar_index
            tmp.upper := hy2
            tmp.lower := ly2
            tmp.adhesion := 0.0
            if jsonAlert == ""
                jsonAlert := f_payload(tmp, "forming", true)

// hide reference drawings if toggled off
if barstate.isconfirmed and not iShowRef
    int t = 0
    while t < array.size(bag)
        Seam s = array.get(bag, t)
        if s.grade == "reference" and not s.dead
            f_delete_lines(s)
        t += 1

// cap visible by adhesion (display count)
if barstate.isconfirmed and array.size(bag) > 0
    // simple: hide extras beyond iDrawN live non-dead
    int live = 0
    int t2 = array.size(bag) - 1
    while t2 >= 0
        Seam s = array.get(bag, t2)
        if not s.dead
            live += 1
            if live > iDrawN
                f_delete_lines(s)
        t2 -= 1

// ─────────────────────────────────────────
// Panel — 4 lines
// ─────────────────────────────────────────
var table panel = table.new(position.top_right, 1, 5, border_width=0)

f_best() =>
    Seam best = na
    float bestA = -1.0
    int t = 0
    while t < array.size(bag)
        Seam s = array.get(bag, t)
        if not s.dead and s.adhesion > bestA
            bestA := s.adhesion
            best := s
        t += 1
    best

if iPanel and barstate.islast
    Seam b = f_best()
    table.cell(panel, 0, 0, "SEAM  " + iSens, text_color=color.new(color.gray, 0), text_size=size.small, bgcolor=color.new(#111318, 15))
    if na(b)
        table.cell(panel, 0, 1, "구조 없음", text_color=color.gray, text_size=size.small, bgcolor=color.new(#111318, 15))
        table.cell(panel, 0, 2, "", text_size=size.small, bgcolor=color.new(#111318, 15))
        table.cell(panel, 0, 3, "", text_size=size.small, bgcolor=color.new(#111318, 15))
        table.cell(panel, 0, 4, "BOX · TRI_SYM  P0", text_color=color.new(color.gray, 30), text_size=size.tiny, bgcolor=color.new(#111318, 15))
    else
        float liveU = f_line_y(b.upper, b.upperSlope, b.lockBar, bar_index)
        float liveL = f_line_y(b.lower, b.lowerSlope, b.lockBar, bar_index)
        float upDist = math.max(liveU - close, 0.0)
        float dnDist = math.max(close - liveL, 0.0)
        float rr = dnDist > 0 ? upDist / dnDist : 0.0
        string name = b.key == "BOX" ? "박스" : "대칭삼각"
        string classic = b.key == "TRI_SYM" ? "고전  방향 미정" : "고전  박스 이탈"
        table.cell(panel, 0, 1, "모양  " + name + " · " + b.phase + " · " + b.grade, text_color=color.white, text_size=size.small, bgcolor=color.new(#111318, 15))
        table.cell(panel, 0, 2, classic + "  위/아래 " + str.tostring(rr, "#.#"), text_color=color.silver, text_size=size.small, bgcolor=color.new(#111318, 15))
        table.cell(panel, 0, 3, "LOCK #" + str.tostring(bar_index - b.lockBar) + "  접점 " + str.tostring(b.touchesU) + "/" + str.tostring(b.touchesL) + "  밀착 " + str.tostring(b.adhesion, "#.##"), text_color=color.silver, text_size=size.small, bgcolor=color.new(#111318, 15))
        string warn = b.rejectReason != "" ? "미달  " + b.rejectReason : "잠금가  " + str.tostring(b.upper, "#.##") + " / " + str.tostring(b.lower, "#.##")
        table.cell(panel, 0, 4, warn, text_color=color.new(color.gray, 10), text_size=size.tiny, bgcolor=color.new(#111318, 15))

// ─────────────────────────────────────────
// Alerts — one condition, JSON body
// TradingView: Any alert() function call
// ─────────────────────────────────────────
alertcondition(false, title="SEAM (use Any alert() function call)", comment="Create alert on this script → Any alert() function call")

if jsonAlert != ""
    alert(jsonAlert, alert.freq_once_per_bar_close)

// lock-dot on recognize bar of best live formal
plotshape(false, title="placeholder", style=shape.diamond, size=size.tiny)
